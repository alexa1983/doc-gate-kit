#!/bin/sh
# dg —— doc-gate-kit 的统一入口（AI 与人走同一条路）
#
#   dg new <目录> [--no-commit]   新建项目：git init → README → 装闸门 → 验证 → 首次提交
#   dg adopt [目录]               老项目：只装钩子与 CI，**基线留给人定性**
#   dg check [目录]               只跑不装，退出码与闸门一致（0／1／2）
#   dg self-test                  拿临时仓库验上面三条路（不动任何真实项目）
#
# **新老的分界线（这是本命令存在的理由）**：
#   新项目没有旧账 → 第一次扫描读到 0 就是真 0 → 可以全自动落基线；
#   老项目已经有文档 → 自动落基线等于把旧账埋了 → 只装不落，人看过再落。
# 这条区分不写清楚，"自动内置"就会变成"自动埋账"，比不装更坏。
#
# 退出码：0 成／1 检查发现比基线差／2 用法或环境不对、闸门跑不成。
set -u

# 本脚本可能被三种方式调用：`sh <路径>/bin/dg`、直接执行、或经 PATH 里的软链敲 `dg`。
# 第三种下 $0 只是个名字（甚至就是 `dg`），dirname 会算到 cwd；软链还会把套件根指到
# `~/.local`。故先把"我到底在哪"解析清楚，再算套件根——2026-10-19 实测踩到。
SELF_PATH=$0
case "$SELF_PATH" in
  */*) : ;;
  *) SELF_PATH=$(command -v "$SELF_PATH" 2>/dev/null || printf '%s' "$SELF_PATH") ;;
esac
while [ -L "$SELF_PATH" ]; do
  link=$(readlink "$SELF_PATH")
  case "$link" in
    /*) SELF_PATH=$link ;;
    *) SELF_PATH=$(dirname "$SELF_PATH")/$link ;;
  esac
done
SELF=$(cd "$(dirname "$SELF_PATH")" && pwd)/$(basename "$SELF_PATH")
KIT_DIR=$(cd "$(dirname "$SELF_PATH")/.." && pwd)
GATE="$KIT_DIR/run_docs_gate.mjs"
INSTALL="$KIT_DIR/install.sh"

say() { printf '%s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*"; }
die() { printf '❌ %s\n' "$*" >&2; exit 2; }

usage() {
  cat <<'EOF'
dg —— 文档闸门（doc-gate-kit）的统一入口

  dg new <目录> [--no-commit]   新建项目：git init → README → 装闸门 → 验证 → 首次提交
  dg adopt [目录]               老项目：只装钩子与 CI，基线留给人定性
  dg check [目录]               只跑不装，退出码与闸门一致
  dg self-test                  拿临时仓库验这三条路

判据（死链、编码）只维护在套件里；项目里只有基线与 4 行 workflow。
EOF
}

need_kit() {
  [ -f "$GATE" ] || die "在 $KIT_DIR 找不到 run_docs_gate.mjs —— dg 必须放在套件的 bin/ 下。"
  [ -f "$INSTALL" ] || die "在 $KIT_DIR 找不到 install.sh —— dg 必须和套件放在一起。"
  command -v node >/dev/null 2>&1 || die "找不到 node。这套东西只需要 node 与 git，但 node 必须在。"
}

cmd_new() {
  [ "$#" -ge 1 ] || die "用法：dg new <目录> [--no-commit]"
  target=$1
  shift
  commit=1
  for a in "$@"; do
    case "$a" in
      --no-commit) commit=0 ;;
      *) die "dg new 不认识的参数：$a" ;;
    esac
  done

  # 防手滑：已有内容的目录一律不动——老项目该走 adopt（它不会替你落基线）。
  # `.DS_Store` 除外：Finder 建出来的"空"文件夹几乎都带它，不该因此被拒。
  if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null | grep -v '^\.DS_Store$')" ]; then
    die "目录已存在且非空：$target
老项目请用：dg adopt \"$target\"（只装，不落基线）"
  fi
  mkdir -p "$target" || die "建不出目录：$target"
  ABS=$(cd "$target" && pwd) || die "进不去：$target"
  cd "$ABS" || die "进不去：$ABS"

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    git init -q || die "git init 失败"
  fi

  if [ ! -f README.md ]; then
    name=$(basename "$ABS")
    printf '# %s\n\n> 一句话说明这个项目是什么。\n\n## 目录\n\n（待补）\n' "$name" > README.md
    say "已写：README.md（闸门要它；一份 Markdown 都没有时，闸门会判「跑不成」）"
  fi

  say ""
  say "=== 装闸门 ==="
  sh "$INSTALL" --no-run || die "install.sh 失败（见上面的输出）"

  say ""
  say "=== 新项目第一次过闸门（必须绿）==="
  node "$GATE" --root "$ABS"
  code=$?
  [ "$code" = "0" ] || die "新项目第一次就没过（退 $code）。这不正常——新项目没有旧账，请查上面的明细。"

  if [ "$commit" = "1" ]; then
    git add -A
    if git commit -q -m "初始：项目骨架 ＋ 文档闸门（doc-gate-kit）"; then
      say ""
      say "已提交初始版本（钩子会在提交时再跑一遍，这就是它该有的样子）。"
    else
      warn "首次提交没成（多半是这台机器没配 git 身份）。文件都已就位，配好后自己提交即可。"
    fi
  fi

  say ""
  say "──────────────────────────────────────────────"
  say "新项目已就绪：$ABS"
  say "  · 基线＝0，是真 0（没有旧账）；以后比 0 差才会红。"
  say "  · 改判据只改套件，项目这边下次 push 自动跟上。"
  say "  · 只想看看现状：dg check \"$ABS\""
  say "──────────────────────────────────────────────"
}

cmd_adopt() {
  target=${1:-.}
  [ -d "$target" ] || die "目录不存在：$target"
  ABS=$(cd "$target" && pwd) || die "进不去：$target"
  cd "$ABS" || die "进不去：$ABS"
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    say "这个目录还不是 git 仓库 —— 先 git init（只建 .git，不动你的文件）。"
    git init -q || die "git init 失败"
  fi
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "取不到仓库根。"
  if [ "$ROOT" != "$ABS" ]; then
    warn "当前目录是 $ROOT 的子目录；闸门装在**仓库根** $ROOT（钩子与 workflow 必须是仓库级的）。"
  fi
  # 已经有别的闸门在管这个仓库时，先说清楚再装，免得两套判据并存
  if [ -f "$ROOT/03_项目工具/闸门基线.json" ]; then
    other=$(node -e '
      try {
        const b = require(process.argv[1]);
        const keys = Object.keys(b["条目"] ?? {}).filter((k) => k !== "死链" && k !== "编码");
        process.stdout.write(keys.join("、"));
      } catch { process.stdout.write(""); }
    ' "$ROOT/03_项目工具/闸门基线.json" 2>/dev/null)
    if [ -n "$other" ]; then
      warn "这个仓库的基线里已经有别的判据：$other"
      warn "本套件只判死链与编码；接入后两套闸门会并存，确认这是你要的再继续。"
    fi
  fi

  say ""
  say "=== 接入已有项目（只装，**不落基线**）==="
  sh "$INSTALL" || die "install.sh 失败（见上面的输出）"

  say ""
  say "──────────────────────────────────────────────"
  say "已接入，但**基线刻意没有落**——老项目第一次跑必然报出历史旧账："
  say ""
  say "  1. 看上面那份明细，逐条定性：真该修就修；"
  say "     指向本机素材、且路径已被 .gitignore 覆盖的，本来就不会计入。"
  say "  2. 定性完再落基线，并把每条「登记」写成\"谁、什么时候、接受了什么\"："
  say ""
  say "      node \"$GATE\" --root \"$ABS\" --update-baseline"
  say ""
  say "  **不要**一把拍平：那等于把旧账埋了，以后\"变红\"和\"本来就红\"再也分不出来。"
  say "──────────────────────────────────────────────"
}

cmd_check() {
  target=${1:-.}
  [ -d "$target" ] || die "目录不存在：$target"
  ABS=$(cd "$target" && pwd) || die "进不去：$target"
  node "$GATE" --root "$ABS"
}

cmd_self_test() {
  pass=0
  fail=0
  ok() { pass=$((pass + 1)); printf '通过  %s\n' "$*"; }
  no() { fail=$((fail + 1)); printf '失败  %s\n' "$*"; }

  T=$(mktemp -d "${TMPDIR:-/tmp}/dg-self.XXXXXX") || die "建不出临时目录"
  trap 'rm -rf "$T"' EXIT INT TERM

  # ① 新项目：文件齐不齐
  if sh "$SELF" new "$T/新项目" --no-commit >"$T/new.log" 2>&1; then
    missing=""
    [ -f "$T/新项目/03_项目工具/闸门基线.json" ] || missing="$missing 基线"
    [ -f "$T/新项目/.github/workflows/docs.yml" ] || missing="$missing workflow"
    [ -x "$T/新项目/.git/hooks/pre-commit" ] || missing="$missing 钩子"
    [ -f "$T/新项目/README.md" ] || missing="$missing README"
    if [ -z "$missing" ]; then
      ok "① dg new 装齐四件（基线／workflow／钩子／README）"
    else
      no "① dg new 装齐四件（缺：$missing）"
    fi
  else
    no "① dg new 执行成功"
    tail -5 "$T/new.log" | sed 's/^/      /'
  fi

  # ② 新项目第一次 check 必须绿
  if sh "$SELF" check "$T/新项目" >/dev/null 2>&1; then
    ok "② 新项目第一次 check 就是绿的"
  else
    no "② 新项目第一次 check 就是绿的"
  fi

  # ③ 非空目录：拒绝（不许把老项目当新项目拍平）
  mkdir -p "$T/老项目"
  printf '# 老项目\n\n[坏](不存在.md)\n' >"$T/老项目/README.md"
  ( cd "$T/老项目" && git init -q )
  if sh "$SELF" new "$T/老项目" >/dev/null 2>&1; then
    no "③ 非空目录被拒绝"
  else
    ok "③ 非空目录被拒绝（老项目该走 adopt）"
  fi

  # ④ adopt 老项目：接入后基线仍是 0（不替人拍平），且 check 应为红（1）
  if sh "$SELF" adopt "$T/老项目" >/dev/null 2>&1; then
    got=$(node -e 'const b=require(process.argv[1]);const n=b["条目"]?.["死链"]?.["指标"]?.["硬死链数"];process.stdout.write(String(n))' "$T/老项目/03_项目工具/闸门基线.json" 2>/dev/null)
    if [ "$got" = "0" ]; then
      ok "④ adopt 不替人落基线（死链基线仍为 0）"
    else
      no "④ adopt 不替人落基线（实测 $got）"
    fi
    sh "$SELF" check "$T/老项目" >/dev/null 2>&1
    got=$?
    if [ "$got" = "1" ]; then
      ok "⑤ 老项目接入后 check 为红（1）——历史旧账如实露出"
    else
      no "⑤ 老项目接入后 check 为红（实测退 $got）"
    fi
  else
    no "④ dg adopt 执行成功"
  fi

  # ⑥ 缺目录：退 2，不许绿
  sh "$SELF" check "$T/没有这个目录" >/dev/null 2>&1
  got=$?
  if [ "$got" = "2" ]; then
    ok "⑥ 不存在的目录退 2"
  else
    no "⑥ 不存在的目录退 2（实测 $got）"
  fi

  # ⑦ 在仓库子目录里 adopt：钩子必须落在仓库根
  #（2026-10-19 实测曾在子目录里跑到仓库外，落到 /private/tmp/.git/hooks）
  R="$T/大仓库"
  mkdir -p "$R/子项目/docs"
  printf '# 子项目\n' >"$R/子项目/README.md"
  ( cd "$R" && git init -q )
  ( cd "$R/子项目" && sh "$SELF" adopt . >/dev/null 2>&1 )
  if [ -x "$R/.git/hooks/pre-commit" ] && [ -f "$R/03_项目工具/闸门基线.json" ]; then
    ok "⑦ 子目录里 adopt：钩子与基线落在仓库根，不落到仓库外"
  else
    no "⑦ 子目录里 adopt：钩子与基线应落在仓库根"
  fi

  # ⑧ 有文档、还没有 .git 的目录：adopt 自己 git init 后装好
  N="$T/无版本库"
  mkdir -p "$N"
  printf '# 已有文档\n\n- [漏](没有.md)\n' >"$N/README.md"
  if sh "$SELF" adopt "$N" >/dev/null 2>&1 && [ -d "$N/.git" ] && [ -f "$N/03_项目工具/闸门基线.json" ]; then
    ok "⑧ 未初始化的文档目录：adopt 自动 git init 并装好"
  else
    no "⑧ 未初始化的文档目录：adopt 应自动 git init 并装好"
  fi

  say ""
  if [ "$fail" = "0" ]; then
    say "结论：$pass 项全过——dg 的三条路都通，新项目第一次就是绿的。"
    exit 0
  fi
  say "结论：$fail 项未过——dg 不可信，别拿它当入口。"
  exit 1
}

need_kit
[ "$#" -ge 1 ] || { usage; exit 2; }
action=$1
shift
case "$action" in
  new) cmd_new "$@" ;;
  adopt) cmd_adopt "$@" ;;
  check) cmd_check "$@" ;;
  self-test) cmd_self_test ;;
  -h|--help|help) usage ;;
  *) usage; die "不认识的子命令：$action" ;;
esac
